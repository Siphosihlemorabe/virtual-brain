{
  "manifest_version": 3,
  "name": "Virtual Brain",
  "version": "0.1.0",
  "description": "Turns what you study online into practice, and remembers what you know.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Virtual Brain"
  }
}
